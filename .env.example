# ════════════════════════════════════════════════════════════════════════════
# Nelskraft Refractory Pvt. Ltd. - Environment Configuration
# ════════════════════════════════════════════════════════════════════════════

# 1. Resend API Key for Contact Form Email Delivery
# Sign up at https://resend.com, generate an API key, and paste it below.
RESEND_API_KEY=re_your_api_key_here

# 2. Recipient Email Address
# Every contact form submission is routed to this exact address.
# Defaults to info@nelskraft.com if not specified.
CONTACT_FORM_TO_EMAIL=info@nelskraft.com

# 3. Verified Sender Email Address
# In development/testing, Resend permits "onboarding@resend.dev".
# In production on Vercel, after verifying the "nelskraft.com" domain in Resend:
# e.g.: CONTACT_FORM_FROM_EMAIL=Nelskraft Inquiries <inquiries@nelskraft.com>
CONTACT_FORM_FROM_EMAIL=Nelskraft Inquiries <onboarding@resend.dev>
